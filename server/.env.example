# procurement-hub backend configuration. See docs/configuration.md for details.
# Empty values are the same as unset. Durations are Go durations plus "d" (days).

# --- Server ---
LISTEN_ADDR=:8080
# /healthz, /readyz and /metrics; "off" disables the ops server.
METRICS_LISTEN_ADDR=:9090
# debug, info, warn or error
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30s

# --- Frontend ---
# Required. Comma-separated exact origins allowed by CORS.
CORS_ALLOWED_ORIGINS=https://procurement.example.org
# Required. Root URL of the SPA, used for links in notifications.
FRONTEND_URL=https://procurement.example.org

# --- MongoDB ---
# Required. Must be a replica set; the database name is the URI path.
# Add authSource when the user is defined in another database.
MONGO_URI=mongodb://procurement:change-me@mongo.example.org:27017/procurement_hub?replicaSet=rs0&authSource=admin

# --- OIDC (Keycloak) ---
# Required. Issuer URL of the realm.
OIDC_ISSUER=https://sso.example.org/realms/example
# Required. Value that the access token's aud claim must contain.
OIDC_AUDIENCE=procurement-hub-api
OIDC_CLOCK_SKEW=60s
OIDC_GROUPS_CLAIM=groups
# Required. System admin roles: "<realm role>" or "<client id>:<role>", comma-separated.
ADMIN_ROLES=procurement-hub-api:admin
# Optional. Roles allowed to use the service, same syntax. Unset = no restriction.
ALLOWED_ROLES=
# Optional. YAML file of managed role-mapping rules.
ROLE_MAPPINGS_FILE=

# --- Secrets ---
# Required. Base64, at least 32 bytes decoded. Generate with: head -c 32 /dev/urandom | base64
WEBHOOK_ENCRYPTION_KEY=

# --- Currencies ---
BASE_CURRENCY=USD
# Optional. Overrides the ISO 4217 minor units of the base currency (0-4).
BASE_CURRENCY_DECIMALS=
# Optional. Comma-separated; defaults to the base currency only.
SUPPORTED_CURRENCIES=

# --- Email notifications ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=procurement@example.org
# starttls, tls or none
SMTP_TLS_MODE=starttls
NOTIFY_DIGEST_WINDOW=5m

# --- Product lookup ---
# none or partfinder
LOOKUP_PROVIDER=none
PARTFINDER_URL=
PARTFINDER_PRICE_CURRENCY=USD
LOOKUP_TIMEOUT=10s
