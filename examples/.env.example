# Settings for the `serve` service in docker-compose.yml. Copy to .env and edit.
# MONGO_URI is set by docker-compose.yml. Every variable is described in
# docs/configuration.md.

# Origins of the SPA, for CORS and links in notifications.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# OIDC provider (e.g. a Keycloak realm). It must be reachable when serve
# starts. See docs/keycloak.md for the client, mapper and role setup.
OIDC_ISSUER=https://sso.example.org/realms/example
OIDC_AUDIENCE=procurement-hub-api
ADMIN_ROLES=procurement-hub-api:admin
# Global purchasing and receiving roles (same syntax as ADMIN_ROLES). Unset means
# nobody has the role: with PURCHASER_ROLES unset nobody can purchase, and with
# RECEIVER_ROLES unset only purchasers can receive. Admins are not purchasers.
PURCHASER_ROLES=procurement-hub-api:purchaser
RECEIVER_ROLES=procurement-hub-api:receiver
# Roles allowed to use the service at all. Unset means no restriction.
ALLOWED_ROLES=

# Base64, at least 32 bytes decoded. Generate with: head -c 32 /dev/urandom | base64
WEBHOOK_ENCRYPTION_KEY=

LOG_LEVEL=info
# Currency of actual costs. SUPPORTED_CURRENCIES is used as given (the base
# currency is not added automatically): it limits the currencies of estimates,
# vendor orders and reference rates.
BASE_CURRENCY=TWD
SUPPORTED_CURRENCIES=TWD,USD

# Product lookup: fills an item's name, vendor, SKU, price and URL from a SKU or
# product URL. none (off) or partfinder. With partfinder, PARTFINDER_URL is the
# root URL of a part-finder server that the serve container can reach (e.g. a
# service on the same compose network). See docs/product-lookup.md.
LOOKUP_PROVIDER=none
PARTFINDER_URL=
# Currency assumed when part-finder's response has none.
PARTFINDER_PRICE_CURRENCY=USD
LOOKUP_TIMEOUT=10s
